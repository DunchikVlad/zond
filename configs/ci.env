# Фиктивные значения ENV для `make config-check` и CI. НЕ секреты.
# Реальные значения — только в локальном окружении / CI-secrets,
# никогда не коммитить (blueprint п. 12).
export CH_TEST_PASSWORD=test
export MONGO_TEST_PASSWORD=test
export CH_PROD_PASSWORD=ci-dummy
export MONGO_PROD_URI=mongodb://ci-dummy@127.0.0.1:27017/ci
export KIMI_API_KEY=ci-dummy
export IDP_METADATA_URL=https://idp.example.com/metadata
